{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritas.dev/schemas/claim-manifest.schema.json",
  "title": "Veritas Claim Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestId", "packetId", "version", "createdAt", "sources", "artifacts", "claims"],
  "properties": {
    "manifestId": {"type": "string", "minLength": 1},
    "packetId": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/claim"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "kind", "resourceId", "anchor", "version"],
      "properties": {
        "sourceId": {"type": "string", "minLength": 1},
        "kind": {"enum": ["google_sheet", "google_doc"]},
        "resourceId": {"type": "string", "minLength": 1},
        "anchor": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "kind", "resourceId", "baseRevisionId", "mutability"],
      "properties": {
        "artifactId": {"type": "string", "minLength": 1},
        "kind": {"enum": ["google_doc", "google_slides", "gmail", "google_task"]},
        "resourceId": {"type": "string", "minLength": 1},
        "containerId": {"type": ["string", "null"], "minLength": 1},
        "baseRevisionId": {"type": "string", "minLength": 1},
        "mutability": {"enum": ["editable", "draft_only", "immutable"]}
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "parameters"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "parameters": {
          "type": "object",
          "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}
        }
      }
    },
    "artifactAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "anchor"],
      "properties": {
        "artifactId": {"type": "string", "minLength": 1},
        "anchor": {"type": "string", "minLength": 1}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "statement", "sourceIds", "artifactAnchors", "risk", "provenance", "freshnessHours"],
      "properties": {
        "claimId": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "artifactAnchors": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifactAnchor"}
        },
        "transformation": {"$ref": "#/$defs/transformation"},
        "risk": {"enum": ["informational", "reversible", "decision_changing", "irreversible"]},
        "provenance": {"enum": ["registered", "candidate"]},
        "freshnessHours": {"type": "integer", "minimum": 1}
      }
    }
  }
}
