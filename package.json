{
  "name": "veritas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "lint": "biome check apps/web/src apps/web/vite.config.ts apps/web/tsconfig.json",
    "format": "biome format --write apps/web/src apps/web/vite.config.ts apps/web/tsconfig.json",
    "typecheck": "pnpm --filter @veritas/web typecheck",
    "test": "pnpm --filter @veritas/web test",
    "build": "pnpm --filter @veritas/web build",
    "verify:phase0": "node scripts/verify-phase-0.mjs",
    "verify:phase1": "node scripts/verify-phase-1.mjs",
    "verify:phase2": "node scripts/verify-phase-2.mjs",
    "verify:phase3": "node scripts/verify-phase-3.mjs",
    "verify:phase4": "node scripts/verify-phase-4.mjs",
    "verify:phase5": "node scripts/verify-phase-5.mjs",
    "verify:phase6": "node scripts/verify-phase-6.mjs",
    "verify:phase7": "node scripts/verify-phase-7.mjs",
    "verify:phase8": "node scripts/verify-phase-8.mjs",
    "verify:phase9": "node scripts/verify-phase-9.mjs",
    "verify:phase10": "node scripts/verify-phase-10.mjs",
    "verify:phase11": "node scripts/verify-phase-11.mjs",
    "verify:phase12": "node scripts/verify-phase-12.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9"
  }
}
