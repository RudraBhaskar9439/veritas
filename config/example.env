# Non-secret runtime configuration
VERITAS_ENVIRONMENT=preview
VERITAS_GOOGLE_OAUTH_REDIRECT_URI=https://YOUR_API_HOST/api/v1/auth/google/callback
VERITAS_GOOGLE_KMS_CREDENTIALS_KEY=projects/YOUR_PROJECT/locations/us-central1/keyRings/veritas-preview/cryptoKeys/workspace-credentials
VERITAS_DRIVE_WEBHOOK_URL=https://YOUR_INGRESS_HOST/api/v1/integrations/google-drive/notifications
VERITAS_SNAPSHOT_BUCKET=YOUR_PROJECT-veritas-preview-snapshots
VERITAS_MAX_REQUEST_BYTES=1048576

# Inject these from Secret Manager. Never commit real values.
VERITAS_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/veritas
VERITAS_GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
VERITAS_GOOGLE_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
VERITAS_OAUTH_TICKET_KEY=URL_SAFE_BASE64_OF_32_RANDOM_BYTES
VERITAS_DRIVE_CHANNEL_TOKEN_KEY=URL_SAFE_BASE64_OF_32_RANDOM_BYTES
